# Environment Configuration
NODE_ENV=development
PORT=4001

# Database Configuration
# The backend accepts any of MONGO_URL / MONGO_URI / MONGODB_URI.
# On Render you MUST set one of these to your MongoDB Atlas connection string,
# otherwise the server falls back to localhost and signup returns 500.
#
# ⚠️ CRITICAL: If your Atlas password contains special characters they MUST be
# percent-encoded in the URI:
#   - a literal %  becomes %25
#   - a literal @  becomes %40
#   - a literal :  becomes %3A
#   - a literal /  becomes %2F
#   - a literal ?  becomes %3F
#   - a literal #  becomes %23
# A password with a bare % (e.g. "pa%zz") makes the legacy driver throw
#   "URI malformed, cannot be parsed"
# Use the CONNECTION STRING from Atlas > Connect > Drivers, which already has
# the <password> placeholder, and replace ONLY the <password> placeholder with
# your percent-encoded password.
MONGODB_URI=mongodb+srv://<user>:<encoded-password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# MONGO_URL=mongodb://localhost:27017/shubhmeet
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Configuration
JWT_SECRET=12345-67890-09876-54321

# Frontend origin (used for CORS / Socket.IO)
FRONTEND_URL=http://localhost:8000

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

