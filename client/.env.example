# TalkHub Frontend Environment Configuration
# ===========================================
# Copy this file to `.env.local` for local development, or set these
# variables in your hosting provider dashboard (Vercel/Netlify).
# IMPORTANT: Never commit real `.env` files with actual values.

# Backend REST API base URL. Must be an absolute URL (http:// or https://).
# The app automatically appends "/api/" if it is missing.
# Local development falls back to http://localhost:4001 automatically,
# so this is optional when running locally.
REACT_APP_API_URL=

# Full backend URL used for Socket.IO connections
# (real-time chat, WebRTC signaling).
# Local development falls back to http://localhost:4001 automatically.
REACT_APP_BACKEND_URL=

